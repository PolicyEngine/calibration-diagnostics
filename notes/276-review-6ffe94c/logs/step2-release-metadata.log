# scripts/realmeta.py
"""Restate ledger_targets.py:5855-5934 ledger_filter_* and the keys the fixture drops, for sample facts."""
import gzip, json, math, sys
root = sys.argv[1]; fix = json.load(open(sys.argv[2]))
fs = [json.loads(l) for l in gzip.open(root + '/packages/microcosm-build/tests/fixtures/us_fsa_portfolio_chronicle_347_facts.jsonl.gz', 'rt')]
by = {f['lineage']['source_record_id']: f for f in fs}
SUF = {">=": "_lower_bound", ">": "_lower_bound_exclusive", "<": "_upper_bound", "<=": "_upper_bound_inclusive"}
def at(o, *p):
    for k in p:
        if not isinstance(o, dict): return None
        o = o.get(k)
    return o
def rows(f):
    c = f.get('constraints')
    if isinstance(c, list): return c
    c = at(f, 'universe_constraints', 'constraints')
    return c if isinstance(c, list) else []
def dims(f):
    for k in ('filters', 'dimensions'):
        if isinstance(f.get(k), dict): return f[k]
    return {}
def filt(f):
    out = {}
    d = dims(f)
    for k, v in sorted(d.items()):
        if v is not None: out[f'ledger_filter_{k}'] = str(v)
    for r in rows(f):
        if (r.get('role') or 'filter') != 'filter': continue
        var, op = r.get('variable'), r.get('operator'); s = SUF.get(op)
        if not var or s is None or var in d: continue
        v = r.get('value')
        if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(float(v)): continue
        out.setdefault(f'ledger_filter_{var}{s}', str(v))
    return out
n_with = 0
for row in fix['targets']:
    rid = row['metadata'].get('ledger_source_record_id')
    f = by[rid]; fl = filt(f)
    if fl: n_with += 1
    if row['target_name'].endswith(('.al.dollars_outstanding', 'age_24_and_younger.dollars_outstanding', 'debt_200k_plus.dollars_outstanding')) or 'parent_plus' in row['target_name']:
        print(row['target_name']); print('  fixture metadata keys:', sorted(row['metadata']))
        print('  release ledger_filter_*:', fl)
        print('  fact constraints:', json.dumps(rows(f))[:400])
        print('  release keys the reader reads but fixture lacks:', {k: at(f, *p) for k, p in {
            'ledger_aggregate_fact_key': ('aggregate_fact_key',), 'ledger_semantic_fact_key': ('semantic_fact_key',),
            'ledger_legacy_fact_key': ('legacy_fact_key',), 'ledger_geography_vintage': ('geography', 'vintage'),
            'ledger_geography_name': ('geography', 'name'), 'ledger_dimension_set_key': ('dimension_set_key',),
            'ledger_universe_constraint_set_key': ('universe_constraint_set_key',),
            'ledger_concept_relation': ('concept_alignment', 'relation'), 'ledger_concept_authority': ('concept_alignment', 'authority')}.items() if at(f, *p)})
print('rows whose release metadata would carry ledger_filter_* keys:', n_with, 'of', len(fix['targets']))
print('source_period values in fixture:', sorted({r['metadata'].get('source_period') for r in fix['targets']}))
