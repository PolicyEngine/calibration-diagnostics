inputs/dashboard-836fc66/frontend/packages/calibration-tree/src/latest-artifact.ts:539-641
  539: // Whether a target's hierarchy lists the group-by pair its Chronicle fields
  540: // carry. A listed pair shows that every fact of the target's identity shares
  541: // it; an omitted pair shows nothing. _calibration_hierarchy builds the
  542: // hierarchy from the identity facts (ledger_targets.py:1096-1100 at 0ff293b),
  543: // and _inherited_dimensions (:1578-1611) lists a pair only when every fact's
  544: // ordinary dimensions share it (_common_dimensions, :1614-1623) or every
  545: // fact's layout carries the same group-by pair (_constant_text, :1649-1651).
  546: // The label validator reads a fact's group-by pair as one of its dimensions
  547: // (:1486-1490), but _inherited_dimensions does not, so two facts that both
  548: // describe one value, one in its dimensions and one in its layout, leave it
  549: // out of the hierarchy.
  550: function hierarchyListsGroupBy(row: TargetRow, chronicle: JsonObject): boolean {
  551:   const groupBy = stringValue(chronicle.layout_groupby_dimension)?.trim();
  552:   const value = stringValue(chronicle.layout_groupby_value_id)?.trim();
  553:   if (row.dimension_adapter !== "hierarchy" || !groupBy || !value) return false;
  554:   const dimensions = Array.isArray(row.target_dimensions) ? row.target_dimensions : [];
  555:   return dimensions.some((dimension) => {
  556:     const listed = asObject(dimension);
  557:     return listed.key === groupBy && listed.value_id === value;
  558:   });
  559: }
  560: 
  561: // What a multi-fact target's fields establish about the group-by pair its
  562: // Chronicle fields carry: "shared" when its identity is one fact or its
  563: // hierarchy lists the pair, so every identity fact shares it; "unlisted" when
  564: // its identity spans several facts and its hierarchy leaves the pair out, which
  565: // does not show whether the facts share it; null when it carries no pair or
  566: // has no hierarchy to read.
  567: function groupByAcrossIdentity(
  568:   row: TargetRow,
  569:   chronicle: JsonObject,
  570:   oneFact: boolean,
  571: ): "shared" | "unlisted" | null {
  572:   if (
  573:     !stringValue(chronicle.layout_groupby_dimension) ||
  574:     !stringValue(chronicle.layout_groupby_value_id)
  575:   ) {
  576:     return null;
  577:   }
  578:   if (oneFact || hierarchyListsGroupBy(row, chronicle)) return "shared";
  579:   return row.dimension_adapter === "hierarchy" ? "unlisted" : null;
  580: }
  581: 
  582: // The Chronicle fields a page shows for a target. Microcosm stamps a target's
  583: // single-fact fields from one representative fact (ledger_targets.py:1085-1090
  584: // at 0ff293b). A target built from several facts also lists every one of them,
  585: // ratio operands included, in ledger_member_fact_count and
  586: // ledger_member_fact_keys (_multi_fact_reference_metadata, :1318-1341). Its
  587: // identity depends on its value operation (identity_facts, :1018-1035):
  588: // - scaled_by_ratio: the representative alone, the base cell that its
  589: //   numerator and denominator translate;
  590: // - rolled_forward_by_ratio: its base cells, which ledger_value_base_cells
  591: //   counts (:1174);
  592: // - allocated_residual_by_ratio: the cells its selector matches, the base its
  593: //   ledger_allocation_receipt lists;
  594: // - calendar_year_window_scaled_by_ratio: its window, two years of each
  595: //   series (:4270-4272, :4331);
  596: // - any other operation: every fact.
  597: // For the first three operations the representative is the first base cell
  598: // (_value_representative_fact, :1232-1245), so an identity of one fact is the
  599: // representative. For any other multi-fact operation it is the fact of the
  600: // latest period, the last in the tuple on a tie, taken from the window for
  601: // calendar_year_window_scaled_by_ratio (:1012-1016). A target whose identity
  602: // is one fact shows its fields as they are, with member_fact_count and
  603: // member_fact_keys added. An identity of several facts has no one record or
  604: // fact key, so those read null. Its group-by value shows when its hierarchy
  605: // lists the pair, because every identity fact then shares it, and reads null
  606: // otherwise. layout_groupby_unlisted_across_facts says the second: the
  607: // identity spans several facts and its hierarchy lists no group-by pair the
  608: // target carries. That does not show that the facts differ in it (see
  609: // hierarchyListsGroupBy). Nothing Microcosm writes says whether the identity
  610: // facts share a universe constraint, so its set key and count read null.
  611: // ledger_aggregation_varying_dimensions cannot settle either question: it
  612: // compares each fact's ordinary dimensions, ratio operands included, and
  613: // counts a dimension one fact carries and another lacks as varying (:1323,
  614: // :1626-1646). The row itself keeps every field, so a comparison still matches
  615: // it by fact key. A single-fact target's fields show as they are.
  616: function shownChronicle(row: TargetRow): unknown {
  617:   const metadata = asObject(row.metadata);
  618:   const memberFactCount = countOrNull(metadata.ledger_member_fact_count);
