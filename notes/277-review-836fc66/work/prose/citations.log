 1584:     groupby_value_id = _constant_text(facts, "layout", "groupby_value_id")
 1585:     if groupby_id and groupby_value_id:
 1586:         raw_value = common.pop(groupby_id, groupby_value_id)
 1587:         dimensions.append(
 1588:             HierarchyDimension(
 1589:                 id=groupby_id,
 1590:                 label=(
 1591:                     _constant_text(facts, "layout", "groupby_dimension_label")
 1592:                     or _dimension_label(facts, groupby_id)
 1593:                 ),
 1594:                 value_id=_dimension_value_id(groupby_value_id),
 1595:                 value_label=(
 1596:                     _constant_text(facts, "layout", "groupby_value_label")
 1597:                     or _dimension_value_label(facts, groupby_id, raw_value)
 1598:                 ),
 1599:             )
 1600:         )
 1601:     for dimension_id in sorted(common):
 1602:         value = common[dimension_id]
 1603:         dimensions.append(
 1604:             HierarchyDimension(
 1605:                 id=dimension_id,
 1606:                 label=_dimension_label(facts, dimension_id),
 1607:                 value_id=_dimension_value_id(value),
 1608:                 value_label=_dimension_value_label(facts, dimension_id, value),
 1609:             )
 1610:         )
 1611:     return tuple(dimensions)
 1612: 
 1613: 
 1614: def _common_dimensions(facts: tuple[object, ...]) -> dict[str, object]:
 1615:     first = {str(key): value for key, value in _dimensions(facts[0]).items()}
 1616:     return {
 1617:         key: value
 1618:         for key, value in first.items()
 1619:         if all(
 1620:             key in _dimensions(fact) and _dimensions(fact)[key] == value
 1621:             for fact in facts[1:]
 1622:         )
 1623:     }
 1624: 
 1625: 
 1626: def _varying_dimension_ids(facts: tuple[object, ...]) -> list[str]:
 1627:     if len(facts) < 2:
 1628:         return []
 1629:     dimension_ids = sorted(
 1630:         {str(key) for fact in facts for key in _dimensions(fact).keys()}
 1631:     )
 1632:     return [
 1633:         dimension_id
 1634:         for dimension_id in dimension_ids
 1635:         if len(
 1636:             {
 1637:                 json.dumps(
 1638:                     _dimensions(fact).get(dimension_id),
 1639:                     sort_keys=True,
 1640:                     separators=(",", ":"),
 1641:                 )
 1642:                 for fact in facts
 1643:             }
 1644:         )
 1645:         > 1
 1646:     ]
 1647: 
 1648: 
 1649: def _constant_text(facts: tuple[object, ...], *path: str) -> str:
 1650:     values = {_str_at(fact, *path).strip() for fact in facts}
 1651:     return next(iter(values)) if len(values) == 1 else ""

