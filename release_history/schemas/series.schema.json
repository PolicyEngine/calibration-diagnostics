{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PolicyEngine/calibration-diagnostics/release_history/schemas/series.schema.json",
  "title": "Release history series record",
  "description": "A country's builds as its release repository's releases.json lists them, each with its file (`release_history/series.py`). Replaced each run. Version 1: every key listed here is required and no other key is allowed. A key added later is declared here with the version that added it, and is not required, so the points already stored stay valid and no format version moves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "country",
    "release_repo",
    "rule",
    "revision",
    "commit",
    "listed_at",
    "record",
    "lines",
    "builds"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "release_history.series"
    },
    "country": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "release_repo": {
      "type": "string"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releases",
        "since"
      ],
      "properties": {
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "since": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          ]
        }
      }
    },
    "revision": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "listed_at": {
      "type": "string"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "sha256",
        "default"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "release",
          "present",
          "role"
        ],
        "properties": {
          "release": {
            "type": "string"
          },
          "present": {
            "type": "boolean"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "builds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "build_id",
          "release",
          "build",
          "release_directory",
          "published_at",
          "withdrawn",
          "current",
          "in_default_release",
          "role",
          "digest",
          "dataset_path",
          "release_manifest_sha256",
          "listing_status",
          "listing_reason"
        ],
        "properties": {
          "build_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "release": {
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "release_directory": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "withdrawn": {
            "type": "boolean"
          },
          "current": {
            "type": "boolean"
          },
          "in_default_release": {
            "type": "boolean"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "digest": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          },
          "dataset_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "release_manifest_sha256": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          },
          "listing_status": {
            "enum": [
              "ok",
              "refused"
            ]
          },
          "listing_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
